# Database — leave unset to use local SQLite (backend/leads.db).
# For PostgreSQL/Supabase set e.g.:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Google Gemini API key — https://aistudio.google.com/apikey (free)
# Without it the agent runs in local-fallback mode (same tools, no LLM reasoning).
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# --- Deployment-only settings (not needed for local dev) ---
# Port for the backend server (Render sets this automatically)
PORT=8000

# Comma-separated frontend origins allowed by CORS, e.g. your Vercel URL
ALLOWED_ORIGINS=

# Set to 1 on a fresh deployment to auto-seed demo leads on first boot
AUTO_SEED=0
